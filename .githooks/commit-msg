#!/bin/sh
# Enforces Conventional Commits on the first line of a commit message.
#   <type>(<optional scope>)<!>: <subject>
# Enable once per clone:  git config core.hooksPath .githooks
# Merge, revert and fixup/squash commits generated by git are let through.
msg_file=$1
first=$(sed -n '1{p;q}' "$msg_file")

case "$first" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if printf '%s\n' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*$'; then
  if [ "$(printf '%s' "$first" | wc -m)" -gt 100 ]; then
    echo "commit-msg: the first line is longer than 100 characters" >&2
    exit 1
  fi
  exit 0
fi

cat >&2 <<'MSG'
commit-msg: the first line must follow Conventional Commits:
  <type>(<scope>)<!>: <subject>
  types: feat fix docs style refactor perf test build ci chore revert
  e.g.   feat(sync): save your position to Audible
         fix(setup)!: rename the sign-in setting
See CONTRIBUTING.md.
MSG
exit 1
